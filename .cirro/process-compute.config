
process {
  executor = 'awsbatch'

  withName: split_intervals {
    errorStrategy = 'terminate'
    maxRetries = 2
    cpus   = { 2 * task.attempt } 
    memory = 16.GB
  }

  withName: subset_tumor_per_shard {
    errorStrategy = 'terminate'
    maxRetries = 2
    cpus   = { 1 * task.attempt } 
    queue        = "${PW_ONDEMAND_JOB_QUEUE}"
    memory = 32.GB
  }

  withName: mutect_wrapper {
    errorStrategy = 'retry'
    maxRetries = 3
    // increase memory each attempt
    memory = { ((params.mem_gb ?: 16) as Integer).GB * task.attempt }   // 16GB, 32GB, 48GB...
    cpus   = 2
  }

  withName: gather_vcfs {
    errorStrategy = 'retry'
    maxRetries = 2
    cpus   = { 2 * task.attempt } 
    memory = 16.GB
  }

  
}

aws {
  region = 'us-east-1'
}