process {
  executor = 'awsbatch'

  withName: split_intervals {
    errorStrategy = 'retry'
    maxRetries = 2
    cpus   = { 2 * task.attempt } 
    memory = 16.GB
  }

  withName: mutect_wrapper {
    errorStrategy = 'retry'
    maxRetries = 2

    // increase memory each attempt
    memory = { 32.GB * task.attempt }   // 16GB, 32GB, 48GB...
    cpus   = 4
  }

  withName: gather_vcfs {
    errorStrategy = 'retry'
    maxRetries = 2
    cpus   = { 2 * task.attempt } 
    memory = 16.GB
  }
}

aws {
  region = 'us-east-1'
}